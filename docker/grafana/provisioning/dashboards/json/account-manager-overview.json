          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (\n  sum(rate(http_requests_received_total{job=\"accountmanager-api\",code=~\"[45]..\"}[5m]))\n  /\n  clamp_min(sum(rate(http_requests_received_total{job=\"accountmanager-api\"}[5m])), 1e-9)\n)",
