FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY AccountManager.slnx ./
COPY src/AccountManager.Gateway/*.csproj src/AccountManager.Gateway/
RUN dotnet restore src/AccountManager.Gateway/AccountManager.Gateway.csproj

COPY src/AccountManager.Gateway/ src/AccountManager.Gateway/
RUN dotnet publish src/AccountManager.Gateway/AccountManager.Gateway.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "AccountManager.Gateway.dll"]
